DATABASE_URL=postgres://user:pass@host/db
AUTH_SECRET=generar-con-npx-auth-secret
AUTH_GOOGLE_ID=xxx.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=xxx
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Opcionales (ver la tabla de variables y "MercadoLibre" en el README): con las dos y la cuenta conectada (con un
# email de MELI_ADMIN_EMAILS, en /api/mercadolibre/conectar), los links de MercadoLibre se leen con su API oficial;
# sin ellas, de la página. La conexión pide NEXT_PUBLIC_BASE_URL con https.
